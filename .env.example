# Copy to .env and adjust. Used by docker compose (${MODAL_*}) and for running
# API/agents on the host while Postgres/Redis run via compose.

# Host access to Postgres published as localhost:55432 (see docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://psp:psp@localhost:55432/psp_db

REDIS_URL=redis://localhost:6379/0

# Modal (long sequences / ColabFold path) — optional
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# XMPP — when running agents on the host against compose Prosody (localhost:5222),
# add a hosts entry: 127.0.0.1 xmpp  (SPADE uses the JID domain as server hostname)
XMPP_DOMAIN=xmpp
XMPP_PASSWORD=secret123
XMPP_AUTO_REGISTER=1
XMPP_USE_TLS=0
XMPP_FORCE_STARTTLS=0
XMPP_USE_SSL=0
XMPP_ALLOW_UNENCRYPTED_PLAIN_AUTH=1

ENABLE_MODAL=1

# Synthesis: prefer experimental PDB when best resolution is at or below this (Å)
EXPERIMENTAL_PREFERRED_RESOLUTION_A=2.5
# Synthesis: minimum AlphaFold DB mean pLDDT to choose AF over predictions when experimental is weak
ALPHAFOLD_MIN_CONFIDENCE=70
