# Copy to .env and replace every placeholder below. Never commit .env (see .gitignore).
# Docker Compose reads .env from this folder for variable substitution.

# Postgres — pick your own user, password, and database name (not the values below).
POSTGRES_USER=devdb_user
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=devdb

# Host-only: API/agents on your machine, Postgres in Docker (compose maps 55432->5432).
# Must use the same user, password, and DB name as the three lines above.
# URL-encode the password if it contains @ : / ? # etc.
DATABASE_URL=

REDIS_URL=redis://localhost:6379/0

# Modal (long sequences / ColabFold path) — optional
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# XMPP — when running agents on the host against compose Prosody (localhost:5222),
# add a hosts entry: 127.0.0.1 xmpp  (SPADE uses the JID domain as server hostname)
XMPP_DOMAIN=xmpp
XMPP_PASSWORD=replace_with_xmpp_secret
XMPP_AUTO_REGISTER=1
XMPP_USE_TLS=0
XMPP_FORCE_STARTTLS=0
XMPP_USE_SSL=0
XMPP_ALLOW_UNENCRYPTED_PLAIN_AUTH=1

ENABLE_MODAL=1

# Synthesis: prefer experimental PDB when best resolution is at or below this (Å)
EXPERIMENTAL_PREFERRED_RESOLUTION_A=2.5
# Synthesis: minimum AlphaFold DB mean pLDDT to choose AF over predictions when experimental is weak
ALPHAFOLD_MIN_CONFIDENCE=70
